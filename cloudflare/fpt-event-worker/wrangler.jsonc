{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nm7-fpt-event-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "FPT_EVENT_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0-59/5 * * * *",
      "1-59/5 * * * *",
      "2-59/5 * * * *",
      "3-59/5 * * * *",
      "4-59/5 * * * *"
    ]
  }
}
